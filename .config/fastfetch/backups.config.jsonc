{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/jcgomez91/.config/fastfetch/logo/kumapls-anime.gif",
    "width": 30,
    "height": 14,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "display": {
      "separator": " ➜  "
  },
  "modules": [
    // Título usuario@host
    {
        "type": "title",
        "format": "{@1}@{2}", 
        "keyColor": "red"
    },
    "break",

    // --- SECCIÓN HARDWARE ---
    {
        "type": "custom",
        "format": "\u001b[32m─────────── 󰌢 Hardware ───────────\u001b[0m" // Verde
    },
    {
        "type": "host",
        "key": "  󰌢 PC ",
        "keyColor": "green"
    },
    {
        "type": "cpu",
        "key": "   CPU",
        "keyColor": "green"
    },
    {
        "type": "gpu",
        "key": "  󰍛 GPU",
        "keyColor": "green"
    },
    {
        "type": "memory",
        "key": "   RAM",
        "keyColor": "green"
    },
    {
        "type": "disk",
        "key": "   SSD",
        "keyColor": "green",
        "folders": "/"
    },

    // --- SECCIÓN SOFTWARE ---
    {
        "type": "custom",
        "format": "\u001b[34m─────────── 󰇄 Software ───────────\u001b[0m" // Azul
    },
    {
        "type": "os",
        "key": "   OS ",
        "keyColor": "blue"
    },
    {
        "type": "kernel",
        "key": "   Ker",
        "keyColor": "blue"
    },
    {
        "type": "packages",
        "key": "  󰏖 Pkg",
        "keyColor": "blue"
    },
    {
        "type": "shell",
        "key": "   Sh ",
        "keyColor": "blue"
    },
    {
        "type": "wm",
        "key": "   WM ",
        "keyColor": "blue"
    },
    {
        "type": "terminal",
        "key": "   Ter",
        "keyColor": "blue"
    },

    // --- SECCIÓN TIEMPO ---
    {
        "type": "custom",
        "format": "\u001b[35m───────────  Tiempos ────────────\u001b[0m" // Magenta
    },
    {
        "type": "uptime",
        "key": "  󰅐 Up ",
        "keyColor": "magenta"
    },
    {
        "type": "command",
        "key": "  🎂 Age",
        "keyColor": "magenta",
        "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference días"
    },
    "break",
    
    // --- COLORES ---
    {
        "type": "colors",
        "paddingLeft": 2,
        "symbol": "circle"
    }
  ]
}
